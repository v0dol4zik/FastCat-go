{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "arch_small",
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "packages",
    {
      "type": "disk",
      "format": "{size-used} / {size-total}"
    },
    "wm",
    "terminal"
  ]
}
